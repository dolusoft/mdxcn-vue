{
  "name": "mdxcn-vue",
  "version": "0.1.1",
  "description": "Vue 3 port of mdxcn: ASCII-style graph and prose components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./graph.css": "./dist/graph.css",
    "./host.css": "./dist/host.css",
    "./theme.css": "./dist/theme.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./knap": {
      "types": "./dist/knap/graph-knap.d.ts",
      "import": "./dist/knap.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@comark/vue": "0.7.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "comark": "0.7.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dolusoft/mdxcn-vue.git",
    "directory": "packages/mdxcn-vue"
  },
  "homepage": "https://github.com/dolusoft/mdxcn-vue#readme",
  "bugs": {
    "url": "https://github.com/dolusoft/mdxcn-vue/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "mdxcn",
    "markdown",
    "ascii",
    "graphs",
    "vitepress",
    "comark",
    "knap"
  ],
  "author": "Dolusoft",
  "publishConfig": {
    "access": "public"
  }
}
