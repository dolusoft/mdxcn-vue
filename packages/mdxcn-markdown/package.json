{
  "name": "mdxcn-markdown",
  "version": "0.0.0",
  "description": "Build-time Markdown adapter for mdxcn-vue (markdown-it tokens to component props).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@types/markdown-it": "14.2.0",
    "mdxcn-vue": "workspace:*"
  },
  "peerDependencies": {
    "markdown-it": "^14"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.20",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
