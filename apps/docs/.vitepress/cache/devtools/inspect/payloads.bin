<script setup>
import { computed } from "vue";
import VPFeature from "./VPFeature.vue";
const props = defineProps({ features: {
	type: Array,
	required: true
} });
const grid = computed(() => {
	const length = props.features.length;
	if (!length) {
		return;
	} else if (length === 2) {
		return "grid-2";
	} else if (length === 3) {
		return "grid-3";
