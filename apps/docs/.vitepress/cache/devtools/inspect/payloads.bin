}
.VPTeamMembers.medium.count-1 .container[data-v-49c5edc3] {
  max-width: 23rem;
}
.VPTeamMembers.medium.count-2 .container[data-v-49c5edc3] {
  max-width: calc(23rem * 2 + 1.5rem);
