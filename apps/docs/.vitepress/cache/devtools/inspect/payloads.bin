/* flyout variant */
.VPNavBarTranslations[data-v-a817317b] {
  display: none;
}
@media (min-width: 48rem) {
.VPNavBarTranslations[data-v-a817317b] {
    display: flex;
    align-items: center;
}
}
.VPNavBarTranslations .title[data-v-a817317b] {
  padding: 0 1.5rem 0 0.75rem;
  line-height: 2.2857143;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--vp-c-text-1);
}

/* menu-group variant (inside the `⋯` menu) — matches the menu group
   titles */
.group > .title[data-v-a817317b] {
  padding: 0 0.75rem;
  line-height: 2.2857143;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--vp-c-text-2);
}

/* accordion variant (inside the nav screen) */
.VPNavScreenTranslations .title[data-v-a817317b] {
  display: flex;
  align-items: center;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--vp-c-text-1);
}
.VPNavScreenTranslations .icon[data-v-a817317b] {
  font-size: 1rem;
}
.VPNavScreenTranslations .icon.lang[data-v-a817317b] {
  margin-right: 0.5rem;
}
.VPNavScreenTranslations .icon.chevron[data-v-a817317b] {
  margin-left: 0.25rem;
  transition: transform 0.25s;
}
.VPNavScreenTranslations.open .icon.chevron[data-v-a817317b] {
  transform: rotate(180deg);
}
.VPNavScreenTranslations .list[data-v-a817317b] {
  padding: 0.25rem 0 0 1.5rem;
}
.VPNavScreenTranslations .link[data-v-a817317b] {
  line-height: 2.4615385;
  font-size: 0.8125rem;
  color: var(--vp-c-text-1);
}
