.container[data-v-a2a4862a] {
  margin: auto;
  width: 100%;
  max-width: 80rem;
  padding: 0 1.5rem;
}
@media (min-width: 40rem) {
.container[data-v-a2a4862a] {
    padding: 0 3rem;
