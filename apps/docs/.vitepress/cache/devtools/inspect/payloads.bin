<script setup>
import { computed } from "vue";
import VPSponsorsGrid from "./VPSponsorsGrid.vue";
const props = defineProps({
	mode: {
		type: String,
		required: false,
		default: "normal"
	},
	tier: {
		type: String,
		required: false
	},
	size: {
		type: String,
		required: false
	},
	data: {
		type: Array,
		required: true
	}
});
const sponsors = computed(() => {
	const isSponsors = props.data.some((s) => {
		return "items" in s;
	});
	if (isSponsors) {
		return props.data;
	}
	return [{
		tier: props.tier,
		size: props.size,
		items: props.data
	}];
});
</script>

