 : \"div\");\nconst textTag = computed(() => hasChildren.value && props.depth < 5 ? `h${props.depth + 2}` : \"p\");\n// a section needs a heading\nconst sectionTag = computed(() => props.item.text && textTag.value !== \"p\" ? \"section\" : \"div\");\nfunction onItemClick() {\n\t!props.item.link && toggle();\n}\n</script>\n\n<template>\n  <component\n    :is=\"sectionTag\"\n    class=\"VPSidebarItem\"\n    :class=\"[`level-${depth}`, {\n\tcollapsible,\n\tcollapsed,\n\t'is-link': isLink,\n\t'is-active': isActiveLink,\n\t'has-active': hasActiveLink\n}]\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPSidebarItem.vue:26:3\"\n  >\n    <div v-if=\"item.text\" class=\"item\" @click=\"onItemClick\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPSidebarItem.vue:37:5\">\n      <div class=\"indicator\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPSidebarItem.vue:38:7\" />\n\n      <VPLink\n        v-if=\"item.link\"\n        :tag=\"linkTag\"\n        class=\"link\"\n        :aria-current=\"isCurrentLink ? 'page' : undefined\"\n        :href=\"item.link\"\n        :rel=\"item.rel\"\n        :target=\"item.target\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPSidebarItem.vue:40:7\"\n      >\n        <component :is=\"textTag\" class=\"text\" v-html=\"item.text\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPSidebarItem.vue:49:9\" />\n      </VPLink>\n      <component v-else :is=\"textTa