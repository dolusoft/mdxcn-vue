/composables/data\";\nimport { useLayout } from \"../composables/layout\";\nimport VPLocalNavOutlineDropdown from \"./VPLocalNavOutlineDropdown.vue\";\ndefineProps({ open: {\n\ttype: Boolean,\n\trequired: true\n} });\ndefineEmits([\"open-menu\"]);\nconst { theme } = useData();\nconst { isHome, hasSidebar, headers, hasLocalNav } = useLayout();\nconst { y } = useWindowScroll();\nconst navHeight = ref(0);\nonMounted(() => {\n\t// getComputedStyle returns custom properties as their raw token (\"4rem\"),\n\t// so resolve the height by measuring instead of parsing\n\tconst probe = document.createElement(\"div\");\n\tprobe.style.cssText = \"position: absolute; visibility: hidden; height: var(--vp-nav-height)\";\n\tdocument.body.appendChild(probe);\n\tnavHeight.value = probe.offsetHeight;\n\tprobe.remove();\n});\nconst isScrolled = computed(() => y.value >= navHeight.value);\n</script>\n\n<template>\n  <div\n    v-if=\"!isHome && (hasLocalNav || hasSidebar || isScrolled)\"\n    class=\"VPLocalNav\"\n    :class=\"{\n\t'has-sidebar': hasSidebar,\n\t'empty': !hasLocalNav,\n\t'fixed': !hasLocalNav && !hasSidebar\n}\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPLocalNav.vue:29:3\"\n  >\n    <div class=\"container\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPLocalNav.vue:38:5\">\n      <button\n        v-if=\"hasSidebar\"\n        type=\"button\"\n        class=\"menu\"\n        :aria-expanded=\"open\"\n        aria-controls=\"VPSidebarNav\"\n        @click=\"$emit('open-menu')\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPLocalNav.vue:39:7\"\n      >\n        <span class=\"vpi-align-left menu-icon\" aria-hidden=\"true\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPLocalNav.vue:47:9\"></span>\n        <span class=\"menu-text\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPLocalNav.vue:48:9\">\n          {{ theme.sidebarMenuLabel || \"Menu\" }}\n        </span>\n      </button>\n\n      <VPLocalNavOutlineDropdown :headers :navHeight data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPLocalNav.vue:53:7\" />\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.VPLocalNav {\n  position: sticky;\n  top: 0;\n  /*rtl:ignore*/\n  left: 0;\n  z-index: var(--vp-z-index-local-nav);\n  border-bottom: 1px solid var(--vp-local-nav-divider-color);\n  padding-top: var(--vp-layout-top-height, 0px);\n  width: 100%;\n}\n\n/* the background surface — below 60rem it covers just this bar; from 60rem\n   the bar is pinned under the fixed navbar, so the surface extends up\n   behind it and one element carries the backdrop filter for both bars\n   (two stacked filters would show a seam at their shared edge) */\n.VPLocalNav::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  background-color: var(--vp-local-nav-bg-color);\n  backdrop-filter: var(--vp-nav-backdrop-filter);\n  transition: background-color 0.25s;\n}\n\n.VPLocalNav.fixed {\n  position: fixed;\n}\n\n@media (min-width: 60rem) {\n  .VPLocalNav {\n    top: var(--vp-nav-height);\n  }\n\n  .VPLocalNav::before {\n    top: calc(-1 * var(--vp-nav-height));\n  }\n\n  .VPLocalNav.has-sidebar {\n    padding-left: var(--vp-sidebar-width);\n  }\n\n  .VPLocalNav.empty {\n    display: none;\n  }\n}\n\n@media (min-width: 80rem) {\n  .VPLocalNav {\n    display: none;\n  }\n}\n\n.container {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.menu {\n  display: flex;\n  align-items: center;\n  line-height: 2;\n  font-size: 0.75rem;\n  font-weight: 500;\n  color: var(--vp-c-text-2);\n  transition: color 0.5s;\n}\n\n.menu:hover {\n  color: var(--vp-c-text-1);\n  transition: color 0.25s;\n}\n\n@media (min-width: 60rem) {\n  .menu {\n    display: none;\n  }\n}\n\n.menu-icon {\n  margin-right: 0.5rem;\n  font-size: 0.875rem;\n}\n\n.menu,\n:deep(.VPLocalNavOutlineDropdown > button) {\n  padding: 0.75rem 1.5rem 0.6875rem;\n}\n\n@media (min-width: 48rem) {\n  .menu,\n  :deep(.VPLocalNavOutlineDropdown > button) {\n    padding: 0.75rem 2rem 0.6875rem;\n  }\n}\n</style>\n"]}
.VPLocalNav {
  position: sticky;
  top: 0;
  /*rtl:ignore*/
  left: 0;
  z-index: var(--vp-z-index-local-nav);
  border-bottom: 1px solid var(--vp-local-nav-divider-color);
  padding-top: var(--vp-layout-top-height, 0px);
  width: 100%;
}

/* the background surface — below 60rem it covers just this bar; from 60rem
   the bar is pinned under the fixed navbar, so the surface extends up
   behind it and one element carries the backdrop filter for both bars
   (two stacked filters would show a seam at their shared edge) */
.VPLocalNav::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background-color: var(--vp-local-nav-bg-color);
  backdrop-filter: var(--vp-nav-backdrop-filter);
  transition: background-color 0.25s;
}

.VPLocalNav.fixed {
  position: fixed;
}

@media (min-width: 60rem) {
  .VPLocalNav {
    top: var(--vp-nav-height);
  }

  .VPLocalNav::before {
    top: calc(-1 * var(--vp-nav-height));
  }

  .VPLocalNav.has-sidebar {
    padding-left: var(--vp-sidebar-width);
  }

  .VPLocalNav.empty {
    display: none;
  }
}

@media (min-width: 80rem) {
  .VPLocalNav {
    display: none;
  }
}

.container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu {
  display: flex;
  align-items: center;
  line-height: 2;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--vp-c-text-2);
  transition: color 0.5s;
}

.menu:hover {
  color: var(--vp-c-text-1);
  transition: color 0.25s;
}

@media (min-width: 60rem) {
  .menu {
    display: none;
  }
}

.menu-icon {
  margin-right: 0.5rem;
  font-size: 0.875rem;
}

.menu,
:deep(.VPLocalNavOutlineDropdown > button) {
  padding: 0.75rem 1.5rem 0.6875rem;
}

@media (min-width: 48rem) {
  .menu,
  :deep(.VPLocalNavOutlineDropdown > button) {
    padding: 0.75rem 2rem 0.6875rem;
  }
}

.VPSidebar {
  position: fixed;
  top: var(--vp-layout-top-height, 0px);
  bottom: 0;
  left: 0;
  z-index: var(--vp-z-index-sidebar);
  padding: 2rem 2rem 6rem;
  width: calc(100vw - 4rem);
  max-width: 20rem;
  background-color: var(--vp-sidebar-bg-color);
  opacity: 0;
  box-shadow: var(--vp-c-shadow-3);
  overflow-x: hidden;
  overflow-y: auto;
  transform: translateX(-100%);
  transition: opacity 0.5s, transform 0.25s ease;
  overscroll-behavior: contain;
}

.VPSidebar.open {
  opacity: 1;
  visibility: visible;
  transform: translateX(0);
  transition: opacity 0.25s, transform 0.5s cubic-bezier(0.19, 1, 0.22, 1);
}

.dark .VPSidebar {
  box-shadow: var(--vp-shadow-1);
}

@media (min-width: 60rem) {
  .VPSidebar {
    padding-top: var(--vp-nav-height);
    width: var(--vp-sidebar-width);
    max-width: 100%;
    background-color: var(--vp-sidebar-bg-color);
    opacity: 1;
    visibility: visible;
    box-shadow: none;
    transform: translateX(0);
  }
}

@media (min-width: 90rem) {
  .VPSidebar {
    padding-left: max(2rem, calc((100% - (var(--vp-layout-max-width) - 4rem)) / 2));
    width: calc((100% - (var(--vp-layout-max-width) - 4rem)) / 2 + var(--vp-sidebar-width) - 2rem);
  }
}

@media (min-width: 60rem) {
  .curtain {
    position: sticky;
    top: calc(var(--vp-nav-height) * -1);
    left: 0;
    z-index: 1;
    margin-top: calc(var(--vp-nav-height) * -1);
    margin-right: -2rem;
    margin-left: -2rem;
    height: var(--vp-nav-height);
    background-color: var(--vp-sidebar-bg-color);
  }
}

.nav {
  outline: 0;
}
