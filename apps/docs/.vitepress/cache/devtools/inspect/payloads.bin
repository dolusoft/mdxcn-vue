"./VPDocAsideOutline.vue\";\nconst { theme } = useData();\n</script>\n\n<template>\n  <div class=\"VPDocAside\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPDocAside.vue:9:3\">\n    <slot name=\"aside-top\" />\n\n    <slot name=\"aside-outline-before\" />\n    <VPDocAsideOutline data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPDocAside.vue:13:5\" />\n    <slot name=\"aside-outline-after\" />\n\n    <div class=\"spacer\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPDocAside.vue:16:5\" />\n\n    <slot name=\"aside-ads-before\" />\n    <VPDocAsideCarbonAds v-if=\"theme.carbonAds\" :carbon-ads=\"theme.carbonAds\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPDocAside.vue:19:5\" />\n    <slot name=\"aside-ads-after\" />\n\n    <slot name=\"aside-bottom\" />\n  </div>\n</template>\n\n<style scoped>\n.VPDocAside {\n  display: flex;\n  flex-direction: column;\n  flex-grow: 1;\n}\n\n.spacer {\n  flex-grow: 1;\n}\n\n.VPDocAside :deep(.spacer + .VPDocAsideSponsors),\n.VPDocAside :deep(.spacer + .VPDocAsideCarbonAds) {\n  margin-top: 1.5rem;\n}\n\n.VPDocAside :deep(.VPDocAsideSponsors + .VPDocAsideCarbonAds) {\n  margin-top: 1rem;\n}\n</style>\n"]}
