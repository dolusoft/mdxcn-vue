.VPHomeSponsors {
  border-top: 1px solid var(--vp-c-gutter);
  padding-top: 5.5rem !important;
}

.VPHomeSponsors {
  margin: 6rem 0;
}

@media (min-width: 48rem) {
  .VPHomeSponsors {
    margin: 8rem 0;
  }
}

.VPHomeSponsors {
  padding: 0 1.5rem;
}

@media (min-width: 48rem) {
  .VPHomeSponsors {
    padding: 0 3rem;
  }
}

@media (min-width: 60rem) {
  .VPHomeSponsors {
    padding: 0 4rem;
  }
}

.container {
  margin: 0 auto;
  max-width: 72rem;
}

.love {
  margin: 0 auto;
  width: fit-content;
  font-size: 1.75rem;
  color: var(--vp-c-text-3);
}

.icon {
  display: inline-block;
}

.message {
  margin: 0 auto;
  border-top: none;
  padding-top: 0.625rem;
  max-width: 20rem;
  text-align: center;
  letter-spacing: normal;
  line-height: 1.5;
  font-size: 1rem;
  font-weight: 500;
  color: var(--vp-c-text-2);
}

.sponsors {
  padding-top: 2rem;
}

.action {
  padding-top: 2.5rem;
  text-align: center;
}

.VPIcon {
  display: inline-block;
  width: 1em;
  height: 1em;
}

.VPIcon :deep(svg) {
  width: 100%;
  height: 100%;
  fill: currentColor;
}
