.VPNavBarMenu[data-v-1ac60f94] {
  position: relative;
  display: none;
  min-width: 0;
}
.VPNavBarMenu .list[data-v-1ac60f94] {
  display: flex;
  justify-content: flex-end;
}

/* collapsed into the `⋯` menu — kept mounted (hidden, out of the a11y tree
   and tab order) so its natural width stays measurable */
.VPNavBarMenu .list > li.collapsed[data-v-1ac60f94] {
  visibility: hidden;
  position: absolute;
  top: 0;
  left: 0;
  max-width: 100%;
  overflow: hidden;
}
@media (min-width: 48rem) {
.VPNavBarMenu[data-v-1ac60f94] {
    display: flex;
    flex-grow: 1;
    justify-content: flex-end;
}
}
