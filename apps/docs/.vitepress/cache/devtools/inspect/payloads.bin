      <template #aside-ads-after><slot name="aside-ads-after" /></template>
      <template #aside-bottom><slot name="aside-bottom" /></template>
    </VPDoc>

    <component v-else :is="frontmatter.layout || 'doc'" />
  </div>
</template>

