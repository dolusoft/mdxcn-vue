.VPTeamPage {
  margin: 6rem 0;
}

@media (min-width: 48rem) {
  .VPTeamPage {
    margin: 8rem 0;
  }
}

.VPHome :slotted(.VPTeamPageTitle) {
  border-top: 1px solid var(--vp-c-gutter);
  padding-top: 5.5rem !important;
}

:slotted(.VPTeamPageSection + .VPTeamPageSection),
:slotted(.VPTeamMembers + .VPTeamPageSection) {
  margin-top: 4rem;
}

:slotted(.VPTeamMembers + .VPTeamMembers) {
  margin-top: 1.5rem;
}

@media (min-width: 48rem) {
  :slotted(.VPTeamPageTitle + .VPTeamPageSection) {
    margin-top: 1rem;
  }

  :slotted(.VPTeamPageSection + .VPTeamPageSection),
  :slotted(.VPTeamMembers + .VPTeamPageSection) {
    margin-top: 6rem;
  }
}

:slotted(.VPTeamMembers) {
  padding: 0 1.5rem;
}

@media (min-width: 48rem) {
  :slotted(.VPTeamMembers) {
    padding: 0 3rem;
  }
}

@media (min-width: 60rem) {
  :slotted(.VPTeamMembers) {
    padding: 0 4rem;
  }
}

.VPTeamPageTitle {
  padding: 3rem 2rem;
  text-align: center;
}

@media (min-width: 48rem) {
  .VPTeamPageTitle {
    padding: 4rem 3rem 3rem;
  }
}

@media (min-width: 60rem) {
  .VPTeamPageTitle {
    padding: 5rem 4rem 3rem;
  }
}

.title {
  letter-spacing: 0;
  line-height: 1.2222222;
  font-size: 2.25rem;
  font-weight: 500;
}

@media (min-width: 48rem) {
  .title {
    letter-spacing: -0.0104167em;
    line-height: 1.1666667;
    font-size: 3rem;
  }
}

.lead {
  margin: 0 auto;
  max-width: 32rem;
  padding-top: 0.75rem;
  line-height: 1.5;
  font-size: 1rem;
  font-weight: 500;
  color: var(--vp-c-text-2);
}

@media (min-width: 48rem) {
  .lead {
    max-width: 37rem;
    letter-spacing: 0.0075em;
    line-height: 1.4;
    font-size: 1.25rem;
  }
}
