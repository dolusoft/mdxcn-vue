  margin: 0;
  border: none;
  padding: 0;
}

.VPNavScreen .link {
  display: block;
  margin-left: 0.75rem;
  border-radius: 0;
  padding: 0;
  font-weight: 400;
  white-space: normal;
}

.VPNavScreen .link:hover {
  background-color: transparent;
}

.VPLastUpdated {
  line-height: 1.7142857;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--vp-c-text-2);
}

@media (min-width: 40rem) {
  .VPLastUpdated {
    line-height: 2.2857143;
    font-size: 0.875rem;
    font-weight: 500;
  }
}
