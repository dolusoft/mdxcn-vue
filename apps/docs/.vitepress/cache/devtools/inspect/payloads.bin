/* closing is snappier than opening so a panel doesn't linger over the
   neighboring flyout's panel while sweeping across the bar */
.button[aria-expanded="false"] + .menu[data-v-2af836ff] {
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.1s, visibility 0.1s;
}
.button[aria-expanded="true"] + .menu[data-v-2af836ff] {
  opacity: 1;
  visibility: visible;
}
.button[data-v-2af836ff] {
  display: flex;
  align-items: center;
  padding: 0 0.75rem;
  height: var(--vp-nav-height);
  color: var(--vp-c-text-1);
  transition: color 0.5s;
}
.text[data-v-2af836ff] {
  display: flex;
  align-items: center;
  line-height: var(--vp-nav-height);
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--vp-c-text-1);
  transition: color 0.25s;
}
.option-icon[data-v-2af836ff] {
  font-size: 1rem;
}
.text-icon[data-v-2af836ff] {
  margin-left: 0.25rem;
  font-size: 0.875rem;
}
.icon[data-v-2af836ff] {
  font-size: 1.25rem;
  transition: fill 0.25s;
}
.menu[data-v-2af836ff] {
  position: absolute;
  top: calc(var(--vp-nav-height) / 2 + 1.25rem);
  right: 0;
  opacity: 0;
  visibility: hidden;
