defineProps({ items: {
	type: Array,
	required: false
} });
</script>

<template>
  <div class="VPMenu">
    <ul v-if="items" class="items">
      <template v-for="item in items" :key="JSON.stringify(item)">
        <VPMenuLink v-if="'link' in item" :item />
        <component
          v-else-if="'component' in item"
          :is="item.component"
          v-bind="item.props"
          menu
        />
        <VPMenuGroup v-else :text="item.text" :items="item.items" />
      </template>
    </ul>

    <slot />
  </div>
</template>

