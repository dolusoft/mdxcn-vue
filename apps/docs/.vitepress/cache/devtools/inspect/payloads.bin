}
@media (min-width: 60rem) {
.container[data-v-a2a4862a] {
    width: 100%;
    padding: 0 4rem;
}
}

/* stretch to full viewport width, overflow is clipped by .VPHome */
.vp-doc[data-v-a2a4862a] .VPHomeSponsors,
.vp-doc[data-v-a2a4862a] .VPTeamPage {
  margin-left: calc(50% - 50vw);
