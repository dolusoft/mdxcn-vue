if (timer != null) {\n\t\tclearTimeout(timer);\n\t\ttimer = null;\n\t}\n});\n</script>\n\n<template>\n  <div\n    v-for=\"item in items\"\n    :key=\"item.text\"\n    class=\"group\"\n    :class=\"{ 'no-transition': disableTransition }\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPSidebarGroup.vue:25:3\"\n  >\n    <VPSidebarItem :item :depth=\"0\" data-v-inspector=\"../../node_modules/.pnpm/vitepress@2.0.0-alpha.20_@t_f0c9fb3746063a7aaebb87c90ae43430/node_modules/vitepress/dist/client/theme-default/components/VPSidebarGroup.vue:31:5\" />\n  </div>\n</template>\n\n<style scoped>\n.no-transition :deep(.caret-icon) {\n  transition: none;\n}\n\n.group + .group {\n  border-top: 1px solid var(--vp-c-divider);\n  padding-top: 0.625rem;\n}\n\n@media (min-width: 60rem) {\n  .group {\n    padding-top: 0.625rem;\n    width: calc(var(--vp-sidebar-width) - 4rem);\n  }\n}\n</style>\n"]}
.no-transition :deep(.caret-icon) {
  transition: none;
}

.group + .group {
  border-top: 1px solid var(--vp-c-divider);
  padding-top: 0.625rem;
}

@media (min-width: 60rem) {
  .group {
    padding-top: 0.625rem;
    width: calc(var(--vp-sidebar-width) - 4rem);
  }
}

.VPNavScreen {
  position: fixed;
  top: 0;
  /*rtl:ignore*/
  right: 0;
  bottom: 0;
  /*rtl:ignore*/
  left: 0;
  padding: calc(var(--vp-nav-height) + var(--vp-layout-top-height, 0px) + 1px) 2rem 0;
  width: 100%;
  background-color: var(--vp-nav-screen-bg-color);
  overflow-y: auto;
  overscroll-behavior: contain;
  transition: background-color 0.25s;
  pointer-events: auto;
}

.VPNavScreen.fade-enter-active,
.VPNavScreen.fade-leave-active {
  transition: opacity 0.25s;
}

.VPNavScreen.fade-enter-active .container,
.VPNavScreen.fade-leave-active .container {
  transition: transform 0.25s ease;
}

.VPNavScreen.fade-enter-from,
.VPNavScreen.fade-leave-to {
  opacity: 0;
}

.VPNavScreen.fade-enter-from .container,
.VPNavScreen.fade-leave-to .container {
  transform: translateY(-0.5rem);
}

@media (min-width: 48rem) {
  .VPNavScreen {
    display: none;
  }
}

.container {
  margin: 0 auto;
  padding: 1.5rem 0 6rem;
  max-width: 18rem;
}

.menu + .translations,
.menu + .appearance,
.translations + .appearance {
  margin-top: 1.5rem;
}

.menu + .social-links {
  margin-top: 1rem;
}

.appearance + .social-links {
  margin-top: 1rem;
}
